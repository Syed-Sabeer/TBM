# Basic scraping deterrent for Apache/cPanel. User-Agent values can be spoofed;
# public HTML, CSS, JavaScript and images cannot be made copy-proof.
Options -Indexes

RewriteEngine On

# Reject common offline mirroring tools on pages AND assets.
RewriteCond %{HTTP_USER_AGENT} (wget|httrack|webhttrack|winhttrack|webcopier|webzip|webstripper|teleport[\x20_-]?pro|offline[\x20_-]?explorer|sitesucker) [NC]
RewriteRule ^ - [F,L]

# Keep repository metadata and local working files out of public downloads.
# Leave .well-known accessible for certificate validation.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
RewriteRule ^Claude\x20outputs(?:/|$) - [F,L,NC]
RewriteRule (^|/)(?:README\.md|AGENTS\.md)$ - [F,L,NC]

# Use a plain response, avoiding a custom error page that triggers these rules again.
ErrorDocument 403 "Access denied."
