APP_NAME="TBM — Tote Bag Market"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Los_Angeles
APP_URL=http://tbm.test

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tbm
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_FROM_ADDRESS="sales@tbm.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- TBM domain settings -------------------------------------------------
# Gross margin floor. Prices under this need owner sign-off.
TBM_MARGIN_FLOOR=28
# FOB cost as a fraction of the Tier C base price, used until a cost import runs.
TBM_COST_RATIO=0.52
# Sample accounts are a slice of the real book; scale demand for cover figures.
TBM_DEMAND_SCALE=12
